  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "data:hours": "node scripts/build-hours.mjs",
    "data:transit": "node scripts/build-transit.mjs",
    "data:media": "node scripts/build-media.mjs",
    "data:restaurants": "node scripts/build-restaurants.mjs",
    "data:stays": "node scripts/build-stays.mjs",
    "proxy:wish": "node proxy/wish/server.mjs",
    "proxy:test": "node --test proxy/wish/test.mjs",
    "proxy:eval": "node proxy/wish/eval.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
