# Copy this file to .env and fill in the values. .env is ignored by git: never commit it.
# Both values are public by design (they end up inside the app). Never put a secret here.

# Mapbox public token (starts with pk.). Restrict it in the Mapbox dashboard to
# com.krakowloop.app and the preview URLs. Enables Mapbox Standard 3D and real walking routes.
EXPO_PUBLIC_MAPBOX_TOKEN=

# GetYourGuide partner id (direct GetYourGuide partner programme only).
EXPO_PUBLIC_GYG_PARTNER_ID=
