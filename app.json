{
  "expo": {
    "name": "KrakowLoop",
    "slug": "krakowloop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.krakowloop.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "comgooglemaps"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C2550",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.krakowloop.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KrakowLoop uses your location to sort places by distance and, when you ask, to start your walking loop where you are.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "KrakowLoop uses the camera to show historic views over the buildings in front of you. Nothing is recorded or uploaded.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-localization"
    ],
    "scheme": "krakowloop",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07727aab-8a86-4b85-ab39-458d4b3c03f4"
      }
    },
    "owner": "grzanka51",
    "updates": {
      "url": "https://u.expo.dev/07727aab-8a86-4b85-ab39-458d4b3c03f4"
    },
    "runtimeVersion": "exposdk:57.0.0"
  }
}
